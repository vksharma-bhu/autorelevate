\eqn{y\, e^{-y} = S/e}. Since \eqn{W_{-1}(z)} is defined by
\eqn{W_{-1}(z)\, e^{W_{-1}(z)} = z} and \eqn{y \ge 1}, setting
\eqn{w = -y} gives \eqn{w e^w = -S/e}, so
\deqn{w = W_{-1}(-S/e), \qquad \Lambda_0(x_p) = y - 1 = -1 - w.}
